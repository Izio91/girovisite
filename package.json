{
  "name": "girovisite",
  "version": "1.0.0",
  "description": "GiroVisite app with BackEnd and FrontEnd",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^1",
    "@hapi/joi": "^17.1.1",
    "@sap-cloud-sdk/http-client": "^3.22.2",
    "@sap-cloud-sdk/resilience": "^3.22.2",
    "@sap/cds": "^8",
    "@sap/cds-hana": "^2.0.0",
    "@sap/cds-odata-v2-adapter-proxy": "^1.9.21",
    "@sap/hana-client": "^2.22.29",
    "@sap/logging": "^8.2.0",
    "@sap/xsenv": "^5.3.0",
    "@sap/xssec": "^4",
    "express": "^4",
    "hdb": "^0.19.10",
    "moment": "^2.30.1",
    "passport": "^0.7.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.6",
    "@cap-js/sqlite": "^1",
    "@sap/cds-dk": "^8",
    "@sap/hdi-deploy": "^5.3.2"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-frontend": "cds watch --open frontend/webapp/index.html?sap-ui-xx-viewCache=false",
    "undeploy": "cf undeploy girovisite --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "cds": {
    "requires": {
      "auth": "xsuaa",
      "db": "hana",
      "odataS4_V2": {
        "kind": "odata-v2",
        "csrf": true,
        "csrfInBatch": true,
        "credentials": {
          "destination": "S4_HANA"
        }
      },
      "cloudIntegration": {
        "kind": "rest",
        "credentials": {
          "destination": "CloudIntegration_API"
        }
      }
    },
    "hana": {
      "deploy-format": "hdbtable"
    },
    "sql": {
      "native_hana_associations": false
    }
  },
  "sapux": [
    "app/frontend"
  ]
}
